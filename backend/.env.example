# ---------------------------------------------------------------------------
# Computer-Use Automation System — configuration
# Copy to .env and fill in. `.env` is gitignored; never commit real keys.
# ---------------------------------------------------------------------------

# --- LLM provider router (discovery only; replay never calls an LLM) --------
# Ordered, comma-separated preference list.
# Supported: openai, openrouter, nvidia_nim, groq, scripted
# `scripted` is an offline deterministic provider for tests/CI - no key needed.
# If OPENAI_API_KEY is set, `openai` is auto-prepended as the preferred provider.
CUA_LLM_PROVIDERS=openrouter,nvidia_nim

# OpenAI (https://platform.openai.com) - used first whenever OPENAI_API_KEY is set
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# NVIDIA NIM (https://build.nvidia.com)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=deepseek-ai/deepseek-v4-flash-0731

# Groq (https://console.groq.com)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# --- Target application ----------------------------------------------------
# The mock legacy bank app (see src/mockbank). Started by `cua mockbank` / tests.
CUA_TARGET_BASE_URL=http://127.0.0.1:8799

# Per-tenant allowlist config (domains, routes, action risk policy)
CUA_ALLOWLIST_PATH=config/allowlist.example.json

# --- Storage -------------------------------------------------------------
# SQLite path for the Artifact Store (swap for Postgres in production — see REPORT.md)
CUA_DB_PATH=.data/cua.db
# Local evidence/log root (swap for object storage in production)
CUA_EVIDENCE_ROOT=.data/evidence

# --- Run budgets -------------------------------------------------------
CUA_MAX_STEPS=40
CUA_RUN_TIMEOUT_SECONDS=300
CUA_ACTION_TIMEOUT_SECONDS=15

# --- Browser ----------------------------------------------------------
# headed=1 to watch the browser during a discovery run
CUA_HEADED=0

# --- Live per-run Docker sandbox (noVNC + CDP) ----------------------
# 1 = each run gets its own container (watch it live in the console, take over a
# stuck run by clicking in the noVNC canvas). Needs `bash sandbox_image/build.sh`
# and Docker running. 0 = plain headless adapter, no live view.
CUA_USE_SANDBOX=0
CUA_SANDBOX_IMAGE=cua-sandbox:latest
CUA_NOVNC_HOST=localhost
